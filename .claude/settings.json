{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(rm -rf *)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(git tag:*)",
      "Bash(gh release create:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release delete:*)",
      "Bash(gh release upload:*)",
      "Bash(gh * pr merge)",
      "Bash(gh * pr merge *)",
      "Bash(gh * pr review)",
      "Bash(gh * pr review *)",
      "Bash(git * tag)",
      "Bash(git * tag *)",
      "Bash(gh * release create)",
      "Bash(gh * release create *)",
      "Bash(gh * release edit)",
      "Bash(gh * release edit *)",
      "Bash(gh * release delete)",
      "Bash(gh * release delete *)",
      "Bash(gh * release upload)",
      "Bash(gh * release upload *)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(python3:*)",
      "Bash(git * push)",
      "Bash(git * push *)"
    ]
  }
}
